      "highlights": [
        {
          "id": "nmec-architecture",
          "nodeId": "nmec-main",
          "title": "从大厅先看“文明叙事”",
          "period": "当代博物馆",
          "location": "主展厅入口",
          "summary": "大厅的尺度与展柜关系把不同历史阶段放进同一视野，适合先建立整体时间感。",
          "whyItMatters": "它提示这不是某一王朝的专馆，而是一部跨时代的社会史。",
          "lookFor": "先找时间轴，再找同一主题在不同时期的材料变化。",
          "image": "/images/guides/national-museum-egyptian-civilization/main-hall-reviewed.jpg",
          "sourceIds": [
            "src-nmec",
            "src-nmec-main",
            "src-nmec-mummies",
            "src-nmec-hall-photo",
            "src-commons-media"
          ],
          "imageAlt": "埃及国家文明博物馆展厅内的玻璃展柜与挑高空间（2017年实景）"
        },
        {
          "id": "nmec-prehistory",
          "nodeId": "nmec-main",
          "title": "史前生活：技术早于王朝",
          "period": "史前时期",
          "location": "主展厅早期章节",
          "summary": "石器、容器和生活工具应作为环境适应与技术积累来读，而不只是“最古老”的标签。",
          "whyItMatters": "王朝国家并非突然出现；长期的聚落、生产和交换构成前提。",
          "lookFor": "比较器物的磨制、穿孔与表面处理，想象制作步骤。",
          "image": "/images/guides/national-museum-egyptian-civilization/main-hall-reviewed.jpg",
          "sourceIds": [
            "src-nmec-main",
            "src-commons-media"
          ],
          "imageAlt": "埃及国家文明博物馆展厅内的玻璃展柜与挑高空间（2017年实景）"
        },
        {
          "id": "nmec-kingship",
          "nodeId": "nmec-main",
          "title": "王权形象：固定程式中的选择",
          "period": "法老时期",
          "location": "主展厅国家与社会线索",
          "summary": "正面性、比例和冠饰让统治者超越个体肖像，成为秩序的可视符号。",
          "whyItMatters": "同一套视觉语法跨越漫长年代，却会因材料、尺度和政治语境而改变。",
          "lookFor": "看头饰、步姿、铭文位置与身体是否依附背柱。",
          "image": "/images/guides/national-museum-egyptian-civilization/07.jpg",
          "sourceIds": [
            "src-nmec-main",
            "src-commons-media"
          ],
          "imageAlt": "主展厅石刻、雕塑与陈列空间，2022年摄。"
        },
        {
          "id": "nmec-textile-material",
          "nodeId": "nmec-textile",
          "title": "纺织物：最脆弱的社会档案",
          "period": "法老时期至晚期传统",
          "location": "纺织主题",
          "summary": "纤维、染色和补缀保留服饰、劳动与贸易的信息，其意义不低于石雕。",
          "whyItMatters": "柔软材料很少能长期保存，因此每一块残片都能补足日常生活史。",
          "lookFor": "找经纬密度、色线交界与磨损；避免把现代复原色当原状。",
          "image": "/images/guides/national-museum-egyptian-civilization/10.jpg",
          "sourceIds": [
            "src-nmec",
            "src-commons-media"
          ],
          "imageAlt": "主展厅的展柜、宗教艺术与参观环境，2022年摄；不是某件王像特写。"
        },
        {
          "id": "nmec-coptic",
          "nodeId": "nmec-textile",
          "title": "科普特织物：图像在衣料上迁徙",
          "period": "晚期古代",
          "location": "纺织主题",
          "summary": "圆章、人物和植物纹样把地中海图像传统带入衣饰与室内织物。",
          "whyItMatters": "它把宗教、身份和跨文化交流放回可穿戴的日常媒介。",
          "lookFor": "留意图像边框怎样适应织物结构，以及不同色线的层次。",
          "image": "/images/guides/national-museum-egyptian-civilization/10.jpg",
          "sourceIds": [
