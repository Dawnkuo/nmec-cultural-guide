      "hero": {
        "src": "/images/covers/national-museum-egyptian-civilization.jpg",
        "alt": "埃及国家文明博物馆正门广场、石质主立面与上方金字塔形玻璃屋顶",
        "caption": "Roland Unger · CC BY-SA 4.0 · 拍摄：2017-03-05",
        "credit": {
          "author": "Roland Unger",
          "sourcePage": "https://commons.wikimedia.org/wiki/File:NMEC-MainEntrance.jpg",
          "license": "CC BY-SA 4.0",
          "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
          "photographedAt": "2017-03-05"
        },
        "framing": {
          "hero": "contain",
          "directory": "contain",
          "card": "contain",
          "thumbnail": "contain"
